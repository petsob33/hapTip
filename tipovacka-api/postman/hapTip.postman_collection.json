{
  "info": {
    "name": "hapTip API",
    "description": "hapTip API — register/login (Sanctum token) + matches + tips.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/register",
              "host": ["{{base_url}}"],
              "path": ["api", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Novak\",\n  \"email\": \"novak@example.com\",\n  \"password\": \"heslo1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.environment.set(\"token\", data.token);",
                  "    console.log(\"Token saved:\", data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"novak@example.com\",\n  \"password\": \"heslo1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.environment.set(\"token\", data.token);",
                  "    console.log(\"Token saved:\", data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/user",
              "host": ["{{base_url}}"],
              "path": ["api", "user"]
            }
          }
        }
      ]
    },
    {
      "name": "Matches",
      "item": [
        {
          "name": "Create match",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/matches",
              "host": ["{{base_url}}"],
              "path": ["api", "matches"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"home_team\": \"Plzen\",\n  \"away_team\": \"Ostrava\",\n  \"kickoff_time\": \"2026-08-10 18:00:00\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    pm.environment.set(\"match_id\", data.data.id);",
                  "    console.log(\"match_id saved:\", data.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List matches",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/matches",
              "host": ["{{base_url}}"],
              "path": ["api", "matches"]
            }
          }
        }
      ]
    },
    {
      "name": "Tips",
      "item": [
        {
          "name": "Create tip",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/tips",
              "host": ["{{base_url}}"],
              "path": ["api", "tips"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"match_id\": {{match_id}},\n  \"home_goals\": 3,\n  \"away_goals\": 0\n}"
            }
          }
        },
        {
          "name": "Create tip WITHOUT token (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{base_url}}/api/tips",
              "host": ["{{base_url}}"],
              "path": ["api", "tips"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"match_id\": {{match_id}},\n  \"home_goals\": 3,\n  \"away_goals\": 0\n}"
            }
          }
        }
      ]
    }
  ]
}
